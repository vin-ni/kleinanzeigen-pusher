{
  "manifest_version": 3,
  "name": "Kleinanzeigen Pusher",
  "short_name": "KA Pusher",
  "description": "Alte Kleinanzeigen mit einem Klick neu einstellen, damit sie wieder ganz oben in den Suchergebnissen stehen.",
  "version": "2.0.0",
  "homepage_url": "https://github.com/jhinter/kleinanzeigen-pusher",
  "browser_specific_settings": {
    "gecko": {
      "id": "kleinanzeigen-pusher@vinzenzaubry.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.kleinanzeigen.de/m-meine-anzeigen.html*"],
      "run_at": "document_idle",
      "js": ["src/common.js", "src/my-ads.js"],
      "css": ["src/styles.css"]
    },
    {
      "matches": ["https://www.kleinanzeigen.de/p-anzeige-bearbeiten.html*"],
      "run_at": "document_idle",
      "js": ["src/common.js", "src/edit-ad.js"],
      "css": ["src/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/logo-48.png"],
      "matches": ["https://www.kleinanzeigen.de/*"]
    }
  ],
  "icons": {
    "16": "images/logo-16.png",
    "32": "images/logo-32.png",
    "48": "images/logo-48.png",
    "128": "images/logo-128.png"
  }
}
